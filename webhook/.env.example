# Secret key shown when you create the webhook endpoint at
# creator.tebex.io -> Webstore -> Webstore Settings -> Developers -> Webhooks
TEBEX_WEBHOOK_SECRET=your-webhook-secret-here

# Port to listen on
PORT=8080

# Set to "true" only if this app runs behind a reverse proxy (nginx, Caddy,
# Cloudflare Tunnel...) that sets X-Forwarded-For. Otherwise leave unset.
TRUST_PROXY=

# Optional: a Discord webhook URL to announce purchases in a channel.
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=
